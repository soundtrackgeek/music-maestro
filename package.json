{
  "name": "music-maestro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "desktop": "node scripts/prepare-runtime.mjs && tauri dev",
    "package": "node scripts/prepare-runtime.mjs && tauri build",
    "test:engine": "python -m unittest discover -s tests -p test_*.py",
    "format": "prettier --write src scripts vite.config.ts index.html src-tauri/tauri.conf.json src-tauri/capabilities/default.json package.json tsconfig.json",
    "format:check": "prettier --check src scripts vite.config.ts index.html src-tauri/tauri.conf.json src-tauri/capabilities/default.json package.json tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
